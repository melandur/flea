#!/usr/bin/env python3
"""Generate ui/js/Themes.js from vendor/strata-themes.toml.

    tools/flea-themes-gen                 rewrites ui/js/Themes.js
    tools/flea-themes-gen /tmp/out.js     writes somewhere else, for a diff

Strata's bundled palette catalog (MIT, Copyright (c) 2026 LGSE Ltd., see vendor/LICENSE-strata),
most of it Tinted Base16 imports. Strata names nine interface tokens and five syntax ones; Flea
has eight palette roles, so eight of those fourteen cross over and six do not. The mapping, and
why each is the one it is:

    background          -> background        the ground, one to one
    surface             -> dark_background   ui/js/Palette.js SURFACE_KEYS reads this rung first
    text                -> foreground        the ink, one to one
    accent              -> accent            one to one
    danger              -> red               ui/Theme.qml reads Color.urgent, which is red/color1
    dim_text            -> muted             the caption role, lifted to 3:1 where a theme is low
    syntax_string       -> green             base0B is green, and green/color2 is the exec role
    syntax_preprocessor -> cyan              base0C is cyan, and cyan/color6 is the symlink role

The last two are the load-bearing ones. Flea's symlink and executable roles read cyan and green
off an Omarchy palette, and a Strata theme has no ANSI ring at all; its own themes.md records the
Base16 mapping it used, base0B to strings and base0C to preprocessor, so those two syntax tokens
ARE that ring's green and cyan under a different name. Nothing is invented here.

The remaining four Strata tokens (highlight, border, syntax_keyword, syntax_constant, syntax_type)
have no Flea role: ui/Theme.qml's applyColors assigns eight and ignores everything else, which is
the same thing it already does with an Omarchy theme's extra keys.

The output is emitted as colors.toml text per theme rather than as a structure, because that is
exactly what ui/Theme.qml's applyColors already takes: following Omarchy and choosing a catalog
palette then run the identical parse, lift and assign, and a catalog theme cannot drift into a
second code path that the Omarchy one does not have.
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "vendor" / "strata-themes.toml"
DEST = ROOT / "ui" / "js" / "Themes.js"

# Strata token -> the colors.toml key ui/Theme.qml and qs.Commons Color already read.
MAPPING = [
    ("background", "background"),
    ("surface", "dark_background"),
    ("text", "foreground"),
    ("accent", "accent"),
    ("danger", "red"),
    ("dim_text", "muted"),
    ("syntax_string", "green"),
    ("syntax_preprocessor", "cyan"),
]

ID = re.compile(r"^[a-z0-9-]+$")


def fail(message):
    print("flea-themes-gen: " + message, file=sys.stderr)
    raise SystemExit(1)


def parse(body):
    themes = []
    for block in body.split("[[themes]]")[1:]:
        entry = {}
        for line in block.splitlines():
            kv = re.match(r'^\s*([a-z_]+)\s*=\s*"([^"]*)"', line)
            if kv:
                entry[kv.group(1)] = kv.group(2)
        themes.append(entry)
    return themes


def check(entry):
    if not ID.match(entry.get("id", "")):
        fail("the id %r is not the shape src/uistate.rs is_theme_id accepts" % entry.get("id"))
    if "|" in entry.get("name", "") or not entry.get("name"):
        fail("the name %r cannot go in a packed line, or is missing" % entry.get("name"))
    for token, _key in MAPPING:
        value = entry.get(token, "")
        if not re.match(r"^#[0-9a-fA-F]{6}$", value):
            fail("theme %s has no usable %s (%r); every one of the eight is load-bearing"
                 % (entry["id"], token, value))


HEADER = '''.pragma library

// GENERATED by tools/flea-themes-gen from vendor/strata-themes.toml. Do not edit; regenerate.
//
// Strata's bundled palette catalog, %d themes (MIT, Copyright (c) 2026 LGSE Ltd., see
// vendor/LICENSE-strata; most entries are Tinted Base16 palettes it imported). The generator's
// header records which eight of Strata's fourteen tokens cross over and why.
//
// One line per theme, "id|Name|" then the eight colours in the order KEYS names them, because a
// line per colour is 760 lines against ui/js's 300-line hard cap (AGENTS.md "File budget").
var KEYS = [%s]

var CATALOG = [
%s
]

// "omarchy" is not in CATALOG: it is the absence of a catalog choice, and the default. ui/Theme.qml
// reads the desktop's own colors.toml for it, which is what Flea has always done and what the
// README promises; a catalog id only ever replaces the body that read comes back with.
var FOLLOW = "omarchy"

var INDEX = null

function index() {
    if (INDEX)
        return INDEX
    INDEX = {}
    for (var i = 0; i < CATALOG.length; i++)
        INDEX[CATALOG[i].split("|")[0]] = CATALOG[i]
    return INDEX
}

// Every theme as {id, name}, in the catalog's own order, which is Strata's: id-sorted.
function entries() {
    var out = []
    for (var i = 0; i < CATALOG.length; i++) {
        var fields = CATALOG[i].split("|")
        out.push({ id: fields[0], name: fields[1] })
    }
    return out
}

function has(id) {
    return index()[String(id)] !== undefined
}

// The display name, or "" for an id no catalog entry carries.
function nameOf(id) {
    var row = index()[String(id)]
    return row ? row.split("|")[1] : ""
}

// The eight colours of one theme as {key: hex}, or null for an id the catalog does not carry. A
// caller that gets null follows Omarchy, which is what a stored id from a newer build resolves to.
function colorsOf(id) {
    var row = index()[String(id)]
    if (!row)
        return null
    var fields = row.split("|")
    var out = {}
    for (var i = 0; i < KEYS.length; i++)
        out[KEYS[i]] = fields[i + 2]
    return out
}

// One theme as colors.toml text, which is the one thing ui/Theme.qml's applyColors takes. A
// catalog palette therefore runs the same parse, the same WCAG lifts and the same eight
// assignments an Omarchy theme runs, rather than a second path beside them.
function paletteBody(id) {
    var colors = colorsOf(id)
    if (!colors)
        return ""
    var lines = []
    for (var i = 0; i < KEYS.length; i++)
        lines.push(KEYS[i] + ' = "' + colors[KEYS[i]] + '"')
    return lines.join("\\n") + "\\n"
}

// What a stored value means: "" and "omarchy" and an id this build's catalog lost all follow the
// desktop, and only an id the catalog carries selects a palette. One place decides it, so no
// surface can disagree with another about whether a window is following.
function following(id) {
    return !has(id)
}

function resolve(id) {
    return has(id) ? String(id) : FOLLOW
}
'''


def main():
    if not SOURCE.exists():
        fail("%s is missing, so there is nothing to generate from" % SOURCE)
    themes = parse(SOURCE.read_text())
    if not themes:
        fail("no [[themes]] entries in %s" % SOURCE)
    seen = set()
    lines = []
    for entry in themes:
        check(entry)
        if entry["id"] in seen:
            fail("the id %s appears twice, and index() would silently keep one" % entry["id"])
        seen.add(entry["id"])
        fields = [entry["id"], entry["name"]] + [entry[token].lower() for token, _ in MAPPING]
        lines.append('    "%s"' % "|".join(fields))
    keys = ", ".join('"%s"' % key for _token, key in MAPPING)
    text = HEADER % (len(themes), keys, ",\n".join(lines))
    dest = Path(sys.argv[1]) if len(sys.argv) > 1 else DEST
    dest.write_text(text)
    print("%s: %d themes, %d lines" % (dest, len(themes), text.count("\n")))


if __name__ == "__main__":
    main()
