#!/usr/bin/env python3
"""Generate ui/js/FileTypeColors.js from vendor/yazi-icons.toml.

    tools/flea-filetypes-gen                 rewrites ui/js/FileTypeColors.js
    tools/flea-filetypes-gen /tmp/out.js     writes somewhere else, for a diff

The same shape as tools/flea-keymap-gen: one vendored table in, one generated library out, so
the colours in the tree can always be re-derived from the file they came from rather than being
hand-maintained. Only the `fg` and the key of each yazi rule cross over. The `text` glyphs do
not: they are nerd-font codepoints, and AGENTS.md "The row mark: Shape, not a generated font"
already ruled a font glyph out of this tree, so ui/js/FileTypes.js answers the mark instead.

The `conds` rules are dropped on purpose. They colour a link, an orphan, an executable and a
directory, and ui/Theme.qml already takes those four from the Omarchy palette's own roles
(symlink, executable, accent), each lifted to a WCAG ratio against the running background. A
vendored hex would fight the theme on exactly the rows the theme is most specific about.

The packing is one line per distinct colour, because 713 rules over 221 colours is a 221-line
table and a 713-line one, and ui/js gets a 300-line hard cap (AGENTS.md "File budget").
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "vendor" / "yazi-icons.toml"
DEST = ROOT / "ui" / "js" / "FileTypeColors.js"

# name/if, text, fg: yazi writes every rule on one line in exactly this order.
RULE = re.compile(r'\{\s*(?:name|if)\s*=\s*"([^"]*)",\s*text\s*=\s*"([^"]*)",\s*fg\s*=\s*"(#[0-9a-fA-F]{6})"\s*\}')


def section(body, key):
    found = re.search(r"^%s\s*=\s*\[(.*?)^\]" % key, body, re.S | re.M)
    return RULE.findall(found.group(1)) if found else []


def fail(message):
    print("flea-filetypes-gen: " + message, file=sys.stderr)
    raise SystemExit(1)


def collect(body):
    """{"#hex": {"e": [ext...], "n": [name...], "d": [dir...]}}, each list in source order."""
    out = {}
    for key, kind in (("exts", "e"), ("files", "n"), ("dirs", "d")):
        rules = section(body, key)
        if not rules:
            fail("no %s rules in %s, so the table would ship empty" % (key, SOURCE))
        for name, _glyph, fg in rules:
            # A key with a space in it cannot survive the packing, and yazi has never written one.
            if " " in name:
                fail("the %s key %r carries a space, which the packed line cannot hold" % (key, name))
            out.setdefault(fg.lower(), {"e": [], "n": [], "d": []})[kind].append(name.lower())
    return out


def pack(colors):
    lines = []
    for fg in sorted(colors):
        parts = []
        for kind in ("e", "n", "d"):
            if colors[fg][kind]:
                parts.append(kind + ":" + " ".join(colors[fg][kind]))
            # Both halves of a rule are keys, so one that lost its keys is a colour nothing draws.
        lines.append('    "%s|%s"' % (fg, "|".join(parts)))
    return lines


HEADER = '''.pragma library

// GENERATED by tools/flea-filetypes-gen from vendor/yazi-icons.toml. Do not edit; regenerate.
//
// Yazi's filetype colours, which are nvim-web-devicons' table (MIT, Copyright (c) 2023
// nvim-tree, see vendor/LICENSE-yazi-icons). %d rules over %d colours: %d extensions, %d exact
// filenames and %d directory names. The glyphs those rules carry are deliberately not here, see
// the generator's own header and ui/js/FileTypes.js, which answers the mark.
//
// One line per colour, "#hex|e:<exts>|n:<names>|d:<dirs>", because a line per rule is 713 lines
// against ui/js's 300-line hard cap. RULES is the shipped form; MAPS is built from it once.
var RULES = [
%s
]

// Built on first use rather than at import: a window that never draws a coloured mark, which is
// every window until the setting is on, never pays for the three tables.
var MAPS = null

function maps() {
    if (MAPS)
        return MAPS
    MAPS = { e: {}, n: {}, d: {} }
    for (var i = 0; i < RULES.length; i++) {
        var fields = RULES[i].split("|")
        var color = fields[0]
        for (var f = 1; f < fields.length; f++) {
            var kind = fields[f].substring(0, 1)
            var keys = fields[f].substring(2).split(" ")
            for (var k = 0; k < keys.length; k++)
                MAPS[kind][keys[k]] = color
        }
    }
    return MAPS
}

// One directory name, lowercased by the caller. "" for a name no rule covers.
function dirColor(lower) {
    return maps().d[lower] || ""
}

// One exact filename, lowercased by the caller.
function nameColor(lower) {
    return maps().n[lower] || ""
}

// One extension, lowercased by the caller and carrying no leading dot. Yazi writes compound
// extensions ("d.ts", "spec.tsx", "blade.php") as single keys, so the caller offers the longest
// suffix first; see ui/js/FileTypes.js extensions().
function extColor(lower) {
    return maps().e[lower] || ""
}
'''


def main():
    if not SOURCE.exists():
        fail("%s is missing, so there is nothing to generate from" % SOURCE)
    body = SOURCE.read_text()
    colors = collect(body)
    lines = pack(colors)
    counts = {kind: sum(len(v[kind]) for v in colors.values()) for kind in ("e", "n", "d")}
    text = HEADER % (sum(counts.values()), len(colors), counts["e"], counts["n"], counts["d"],
                     ",\n".join(lines))
    dest = Path(sys.argv[1]) if len(sys.argv) > 1 else DEST
    dest.write_text(text)
    print("%s: %d rules, %d colours, %d lines" % (dest, sum(counts.values()), len(colors),
                                                  text.count("\n")))


if __name__ == "__main__":
    main()
