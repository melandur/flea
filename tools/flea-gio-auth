#!/usr/bin/expect -f
# Mounts one GIO URI with one password read from stdin and no secret output.
#   flea-gio-auth <uri> [never|session|permanent]
# The second argument is what GIO's own "Store password?" prompt is answered with, and it defaults
# to never, which is what this helper always answered before Settings > Places grew the switch. On
# permanent the secret goes into the login keyring, gvfs's own store, and a later plain `gio mount`
# of the same URI needs no password at all: that is the whole of "remember password" here, and it is
# the same store Nautilus writes to, so a location saved in one is already known to the other.
log_user 0
set timeout 30
if {[info exists env(FLEA_GIO_AUTH_TIMEOUT)]} {
    set timeout $env(FLEA_GIO_AUTH_TIMEOUT)
}

if {$argc < 1 || $argc > 2 || [gets stdin password] < 0 || $password eq ""} {
    exit 2
}
set uri [lindex $argv 0]
set store "never"
if {$argc == 2} {
    set store [lindex $argv 1]
    if {$store ne "never" && $store ne "session" && $store ne "permanent"} {
        exit 2
    }
}
set password_sent 0

spawn -noecho gio mount $uri
# 3 and 4 are this helper's own refusals, and they are not authentication failures: the password was
# never wrong, the server was never vouched for. They are separate codes because ui/js/Errors.js says
# what happened in one sentence, and "authentication was refused" over an unknown host key sends the
# operator to retype a password that was right all along.
expect {
    -re {Choice: *$} {
        set password ""
        catch {close}
        catch {wait}
        exit 3
    }
    -re {Continue anyway.*y/n} {
        set password ""
        catch {close}
        catch {wait}
        exit 4
    }
    -re {Store password.*never/session/permanent} {
        send -- "$store\r"
        exp_continue
    }
    -re {(Password|password|Passphrase|passphrase).*:} {
        if {$password_sent} {
            catch {close}
            catch {wait}
            exit 1
        }
        send -- "$password\r"
        set password ""
        set password_sent 1
        exp_continue
    }
    eof {
        set result [wait]
        set password ""
        if {!$password_sent && [lindex $result 3] == 0} {
            exit 1
        }
        exit [lindex $result 3]
    }
    timeout {
        set password ""
        catch {close}
        catch {wait}
        exit 124
    }
}
